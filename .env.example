# Environment variables consumed by app.config.ts.
#
# - For EAS Build, these are set per profile in eas.json ("build.<profile>.env")
#   or as EAS environment variables/secrets (`eas env:set`) — not from this file.
# - For local development (`npx expo start`), copy this file to `.env` and fill
#   in real values; Expo CLI loads `.env` automatically. Never commit `.env`.
#
# Never put a real value here. This file documents shape, not secrets.

# -----------------------------------------------------------------------------
# Shared / all environments
# -----------------------------------------------------------------------------

# development | staging | production — selects bundle id, app name, which
# google-services file is wired in, and the Sentry `environment` tag.
# Already set by each EAS Build profile in eas.json; override locally if needed.
APP_ENV=development

# Note: the app version baked into `version` / the Sentry `release` string
# is NOT read from an env var — it's a literal constant (`APP_VERSION`) in
# app.config.ts. `runtimeVersion` uses the `fingerprint` policy, which
# hashes the resolved Expo config; an env-sourced version (or any other
# value that could differ between your machine and the EAS Build machine)
# inside that config makes the locally-computed fingerprint diverge from
# the one computed during the build, and EAS Update aborts the build. Bump
# the version by editing the constant in app.config.ts, not an env var.

# -----------------------------------------------------------------------------
# Firebase — one project per environment (dev / staging / production)
# -----------------------------------------------------------------------------
# Paths are resolved relative to the project root. Defaults (when unset):
#   production  -> ./google-services.json / ./GoogleService-Info.plist
#   staging     -> ./google-services.staging.json / ./GoogleService-Info.staging.plist
#   development -> ./google-services.development.json / ./GoogleService-Info.development.plist
# None of these files are committed (see .gitignore) — fetch them from the
# Firebase console for the matching project and place them locally.
#
# They DO get uploaded to EAS Build though: `.easignore` deliberately does
# not ignore them (unlike `.gitignore`), so the build machine resolves the
# exact same relative path as your local machine. This matters because
# `runtimeVersion` uses the `fingerprint` policy, which hashes the resolved
# Expo config — an EAS *file secret* (e.g. `GOOGLE_SERVICES_FILE`) was tried
# here before and reverted: it resolves to a different (absolute) path on
# the build machine than locally, so the fingerprint computed locally never
# matched the one computed during the build, and every build/update failed
# with "Runtime version calculated on local machine not equal to runtime
# version calculated during build." Do not reintroduce a file-secret
# override for this — uploading the file via `.easignore` is what fixes it.
GOOGLE_SERVICES_JSON=./google-services.development.json

# -----------------------------------------------------------------------------
# Android native build (JDK)
# -----------------------------------------------------------------------------
# Not read by app.config.ts — this is for your shell, consumed by the Gradle
# wrapper when building Android locally (`npm run android`, which wraps
# `expo prebuild` + `expo run:android` — see scripts/android-run.sh).
#
# React Native 0.88 / Expo SDK 58's Gradle setup requires JDK 17 or 21. A
# machine's system-default `java` may already be a newer JDK (e.g. 25), which
# Gradle refuses to use. If so, point JAVA_HOME at a JDK 17 or 21 install
# instead, e.g.:
#   JAVA_HOME=/usr/lib/jvm/java-21-openjdk
# (adjust to whatever JDK 17/21 is actually installed on your machine; the
# path above is just the common Fedora/RHEL layout, not a guarantee it
# exists). scripts/android-preflight.sh checks this for you, and
# scripts/android-run.sh (`npm run android`) exports JAVA_HOME automatically
# once it finds a usable JDK 17/21 — you only need to set it here if you want
# to pin a specific one yourself.
#JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
# DSN is environment-specific if you split Sentry projects per environment, or
# shared with `APP_ENV` as the distinguishing tag — either works with the code
# in src/lib, since it only ever reads extra.sentry.{environment,release,dsn}.
#
# CAUTION (fingerprint): SENTRY_DSN feeds `extra.sentry.dsn`, and SENTRY_ORG /
# SENTRY_PROJECT feed the `@sentry/react-native/expo` plugin's config — all
# three are part of the resolved Expo config that `runtimeVersion`'s
# `fingerprint` policy hashes (measured: changing any one of them changes the
# hash). If any of these is configured as an EAS environment variable/secret
# that exists on the build machine but is unset locally (or vice versa), the
# same "fingerprint calculated locally not equal to fingerprint calculated
# during build" failure documented for GOOGLE_SERVICES_JSON / the old
# EAS_BUILD_* release suffix applies here too. Keep these identical on both
# sides, or unset on both, for every environment that builds.
SENTRY_DSN=
# Used only at build time by the Sentry Expo config plugin to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# EAS Update (expo-updates)
# -----------------------------------------------------------------------------
# No environment variable here on purpose: `updates.url` and `runtimeVersion`
# are set directly in app.config.ts (same EAS project for every environment —
# https://u.expo.dev/e2021b0f-583e-45c8-8002-8d408180bbb1), and `eas.json`
# already pins each build profile to its update channel (`preview` /
# `production`; `development` has none — dev client builds run off Metro, not
# OTA). Publishing an update is `eas update --channel <preview|production>`,
# not something this app reads from the environment.
#
# One footgun this introduces: runtimeVersion uses the `fingerprint` policy,
# which hashes the resolved native project — and that resolution depends on
# APP_ENV (bundle id, google-services file, ...), so a production build's
# fingerprint differs from a staging build's. `eas update` computes the
# fingerprint from the local project state at publish time; it does NOT read
# the target build profile's `env` block for you. Always export APP_ENV to
# match the channel before publishing, e.g.
# `APP_ENV=production eas update --channel production`
# — otherwise the published fingerprint won't match any real build and the
# update silently never reaches devices on that channel.

# -----------------------------------------------------------------------------
# Strava
# -----------------------------------------------------------------------------
# No Strava variables belong here. `client_id` is read at runtime from the
# Firestore document `config/app` via configRepository, and `client_secret`
# lives only in Cloud Functions config (`functions/.env` or
# `firebase functions:secrets:set`) — never in the app bundle or this file.
