{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "demo": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "demo",
      "env": {
        "APP_ENV": "development"
      },
      "ios": {
        "distribution": "store"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {},
    "demo": {
      "ios": {
        "ascAppId": "6833713373"
      }
    }
  }
}
